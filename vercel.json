{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/aurora.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/folio.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/glass.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/nexa.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/kai.html",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "diseno-web-puno/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "soluciones/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "nfc-qr/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "diseno-web-juliaca/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacidad/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/diseno-web-juliaca/?$",
      "dest": "/diseno-web-juliaca/index.html"
    },
    {
      "src": "^/nfc-qr/?$",
      "dest": "/nfc-qr/index.html"
    },
    {
      "src": "^/soluciones/?$",
      "dest": "/soluciones/index.html"
    },
    {
      "src": "^/diseno-web-puno/?$",
      "dest": "/diseno-web-puno/index.html"
    },
    {
      "src": "^/resources/navbars/kai\\.html$",
      "dest": "/resources/navbars/kai.html"
    },
    {
      "src": "^/resources/navbars/nexa\\.html$",
      "dest": "/resources/navbars/nexa.html"
    },
    {
      "src": "^/resources/navbars/glass\\.html$",
      "dest": "/resources/navbars/glass.html"
    },
    {
      "src": "^/resources/navbars/folio\\.html$",
      "dest": "/resources/navbars/folio.html"
    },
    {
      "src": "^/resources/navbars/aurora\\.html$",
      "dest": "/resources/navbars/aurora.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/resources/navbars/?$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "src": "^/resources/navbars/index\\.html$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "src": "^/privacidad/?$",
      "dest": "/privacidad/index.html"
    },
    {
      "src": "^/404/?$",
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
