{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/resources/navbars/?$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "src": "^/resources/navbars/index\\.html$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
