{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "resources/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/resources/navbars/?",
      "dest": "/resources/navbars/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
