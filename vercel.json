{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/aurora.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/folio.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/glass.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/nexa.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/kai.html",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "diseno-web-puno/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "soluciones/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "nfc-qr/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "diseno-web-juliaca/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/diseno-web-juliaca/?$",
      "dest": "/diseno-web-juliaca/index.html"
    },
    {
      "src": "^/nfc-qr/?$",
      "dest": "/nfc-qr/index.html"
    },
    {
      "src": "^/soluciones/?$",
      "dest": "/soluciones/index.html"
    },
    {
      "src": "^/diseno-web-puno/?$",
      "dest": "/diseno-web-puno/index.html"
    },
    {
      "src": "^/resources/navbars/kai\\.html$",
      "dest": "/resources/navbars/kai.html"
    },
    {
      "src": "^/resources/navbars/nexa\\.html$",
      "dest": "/resources/navbars/nexa.html"
    },
    {
      "src": "^/resources/navbars/glass\\.html$",
      "dest": "/resources/navbars/glass.html"
    },
    {
      "src": "^/resources/navbars/folio\\.html$",
      "dest": "/resources/navbars/folio.html"
    },
    {
      "src": "^/resources/navbars/aurora\\.html$",
      "dest": "/resources/navbars/aurora.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/resources/navbars/?$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "src": "^/resources/navbars/index\\.html$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
