{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/aurora.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/folio.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/glass.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/nexa.html",
      "use": "@vercel/static"
    },
    {
      "src": "resources/navbars/kai.html",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "diseno-web-puno/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "soluciones/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "nfc-qr/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "diseno-web-juliaca/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacidad/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "aptitud-web/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "web-para-barberias/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "web-para-restaurantes/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "servicios/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "proyectos/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "planes/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "cotizar/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "demos/maison-dulce/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/.*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://aptitud-labs-demos.martinjobtpaz.chatgpt.site; frame-src 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "^/assets/hero/aptitud-hero-background\\.png$",
      "headers": {
        "Content-Type": "image/jpeg",
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "src": "^/diseno-web-juliaca/?$",
      "dest": "/diseno-web-juliaca/index.html"
    },
    {
      "src": "^/servicios/?$",
      "dest": "/servicios/index.html"
    },
    {
      "src": "^/proyectos/?$",
      "dest": "/proyectos/index.html"
    },
    {
      "src": "^/planes/?$",
      "dest": "/planes/index.html"
    },
    {
      "src": "^/cotizar/?$",
      "dest": "/cotizar/index.html"
    },
    {
      "src": "^/nfc-qr/?$",
      "dest": "/nfc-qr/index.html"
    },
    {
      "src": "^/soluciones(?:/index\\.html)?/?$",
      "status": 308,
      "headers": {
        "Location": "/servicios/"
      }
    },
    {
      "src": "^/diseno-web-puno/?$",
      "dest": "/diseno-web-puno/index.html"
    },
    {
      "src": "^/resources/navbars/kai\\.html$",
      "dest": "/resources/navbars/kai.html"
    },
    {
      "src": "^/resources/navbars/nexa\\.html$",
      "dest": "/resources/navbars/nexa.html"
    },
    {
      "src": "^/resources/navbars/glass\\.html$",
      "dest": "/resources/navbars/glass.html"
    },
    {
      "src": "^/resources/navbars/folio\\.html$",
      "dest": "/resources/navbars/folio.html"
    },
    {
      "src": "^/resources/navbars/aurora\\.html$",
      "dest": "/resources/navbars/aurora.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/resources/navbars/?$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "src": "^/resources/navbars/index\\.html$",
      "dest": "/resources/navbars/index.html"
    },
    {
      "src": "^/privacidad/?$",
      "dest": "/privacidad/index.html"
    },
    {
      "src": "^/404/?$",
      "dest": "/404.html"
    },
    {
      "src": "^/aptitud-web/?$",
      "dest": "/aptitud-web/index.html"
    },
    {
      "src": "^/web-para-barberias/?$",
      "dest": "/web-para-barberias/index.html"
    },
    {
      "src": "^/web-para-restaurantes/?$",
      "dest": "/web-para-restaurantes/index.html"
    },
    {
      "src": "^/demos/maison-dulce/?$",
      "dest": "/demos/maison-dulce/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
